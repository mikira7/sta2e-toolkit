{{!-- sta2e-toolkit | vfx-test-panel.hbs --}}
<div class="sta2e-vfx-panel">
  <style>
    .sta2e-vfx-panel {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 10px;
      max-height: calc(100vh - 140px);
      overflow-y: auto;
      background: #10141f;
      color: #c8d6ef;
      font-family: var(--font-primary, sans-serif);
      font-size: 12px;
    }
    .sta2e-vfx-status {
      display: grid;
      grid-template-columns: 78px 1fr;
      gap: 4px 8px;
      padding: 8px;
      background: #171d2c;
      border-left: 3px solid #33aaff;
    }
    .sta2e-vfx-status-label {
      color: #6d8caf;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .sta2e-vfx-status-value {
      min-width: 0;
      overflow: hidden;
      color: #e5edf8;
      font-size: 12px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .sta2e-vfx-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .sta2e-vfx-row {
      display: grid;
      grid-template-columns: 128px 1fr 58px;
      align-items: center;
      gap: 8px;
    }
    .sta2e-vfx-row label {
      color: #8fb3d1;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .sta2e-vfx-row input,
    .sta2e-vfx-row select {
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
      background: #090c13;
      border: 1px solid #2a3550;
      border-radius: 2px;
      color: #d8e8ff;
      font-size: 11px;
      padding: 4px 6px;
    }
    .sta2e-vfx-row input[type="range"] {
      padding: 0;
      accent-color: #33aaff;
    }
    .sta2e-vfx-row[hidden] {
      display: none;
    }
    .sta2e-vfx-row.is-disabled {
      opacity: 0.48;
    }
    .sta2e-vfx-row.is-disabled input {
      cursor: not-allowed;
    }
    .sta2e-vfx-check {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .sta2e-vfx-check input {
      width: auto;
      margin: 0;
    }
    .sta2e-vfx-number {
      text-align: right;
    }
    .sta2e-vfx-color {
      display: grid;
      grid-template-columns: 1fr 42px;
      gap: 6px;
    }
    .sta2e-vfx-resolved {
      display: flex;
      align-items: center;
      gap: 6px;
      min-width: 0;
      overflow: hidden;
      color: #d8e8ff;
      font-size: 11px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .sta2e-vfx-swatch {
      flex: 0 0 auto;
      width: 16px;
      height: 16px;
      border: 1px solid #2a3550;
      border-radius: 2px;
    }
    .sta2e-vfx-section {
      margin-top: 4px;
      padding-bottom: 3px;
      border-bottom: 1px solid #26314a;
      color: #6d8caf;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .sta2e-vfx-color input[type="color"] {
      height: 26px;
      padding: 2px;
    }
    .sta2e-vfx-actions {
      position: sticky;
      bottom: -10px;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px;
      padding-top: 2px;
      padding-bottom: 2px;
      background: #10141f;
      border-top: 1px solid #26314a;
    }
    .sta2e-vfx-actions button {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-width: 82px;
      justify-content: center;
      padding: 6px 10px;
      border: 1px solid #2d3a58;
      border-radius: 2px;
      background: #172033;
      color: #9ebad6;
      cursor: pointer;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .sta2e-vfx-actions button:hover {
      border-color: #33aaff;
      color: #33aaff;
      background: #10233a;
    }
    .sta2e-vfx-play {
      border-color: #33aaff !important;
      background: #06405f !important;
      color: #ffffff !important;
    }
  </style>

  <div class="sta2e-vfx-status">
    <div class="sta2e-vfx-status-label">Source</div>
    <div class="sta2e-vfx-status-value">{{sourceName}}</div>
    <div class="sta2e-vfx-status-label">Target</div>
    <div class="sta2e-vfx-status-value">{{targetName}}</div>
  </div>

  <div class="sta2e-vfx-grid">
    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-preset">Preset</label>
      <select id="sta2e-vfx-preset" name="preset">
        {{#each presets}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      <span></span>
    </div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-colormode">Color Mode</label>
      <select id="sta2e-vfx-colormode" name="colorMode">
        <option value="auto" {{#if colorAuto}}selected{{/if}}>Auto by Faction</option>
        <option value="custom" {{#if colorCustom}}selected{{/if}}>Custom Hex</option>
      </select>
      <span></span>
    </div>

    <div class="sta2e-vfx-row" data-auto-color-row>
      <label>Resolved</label>
      <div class="sta2e-vfx-resolved">
        <span class="sta2e-vfx-swatch" style="background:{{resolvedColor}};"></span>
        <span>{{resolvedColor}} &mdash; {{resolvedSource}}</span>
      </div>
      <span></span>
    </div>

    <div class="sta2e-vfx-row" data-custom-color-row>
      <label for="sta2e-vfx-color">Color</label>
      <div class="sta2e-vfx-color">
        <input id="sta2e-vfx-color" type="text" name="color" value="{{values.color}}" />
        <input type="color" value="{{values.color}}" data-color-picker />
      </div>
      <span></span>
    </div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-placement">Placement</label>
      <select id="sta2e-vfx-placement" name="placement">
        <option value="above" {{#if placementAbove}}selected{{/if}}>Above tokens</option>
        <option value="below" {{#if placementBelow}}selected{{/if}}>Below tokens</option>
      </select>
      <span></span>
    </div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-duration">Duration</label>
      <input id="sta2e-vfx-duration" type="range" min="500" max="20000" step="250" name="duration" value="{{values.duration}}" data-sync-range="duration" />
      <input type="number" min="500" max="60000" step="250" class="sta2e-vfx-number" value="{{values.duration}}" data-sync-number="duration" />
    </div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-opacity">Opacity</label>
      <input id="sta2e-vfx-opacity" type="range" min="0.05" max="1" step="0.05" name="opacity" value="{{values.opacity}}" data-sync-range="opacity" />
      <input type="number" min="0.05" max="1" step="0.05" class="sta2e-vfx-number" value="{{values.opacity}}" data-sync-number="opacity" />
    </div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-pulse">Pulse Speed</label>
      <input id="sta2e-vfx-pulse" type="range" min="0.1" max="6" step="0.05" name="pulseSpeed" value="{{values.pulseSpeed}}" data-sync-range="pulseSpeed" />
      <input type="number" min="0.1" max="6" step="0.05" class="sta2e-vfx-number" value="{{values.pulseSpeed}}" data-sync-number="pulseSpeed" />
    </div>

    <div class="sta2e-vfx-section">Emitter Rays</div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-raylines">Rays</label>
      <div class="sta2e-vfx-check">
        <input id="sta2e-vfx-raylines" type="checkbox" name="rayLines" {{#if values.rayLines}}checked{{/if}} />
        <span>Fan pulsing rays out from the emitter</span>
      </div>
      <span></span>
    </div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-raycount">Ray Count</label>
      <input id="sta2e-vfx-raycount" type="range" min="0" max="24" step="1" name="rayCount" value="{{values.rayCount}}" data-sync-range="rayCount" />
      <input type="number" min="0" max="24" step="1" class="sta2e-vfx-number" value="{{values.rayCount}}" data-sync-number="rayCount" />
    </div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-raywidth">Ray Width</label>
      <input id="sta2e-vfx-raywidth" type="range" min="0.5" max="10" step="0.1" name="rayWidth" value="{{values.rayWidth}}" data-sync-range="rayWidth" />
      <input type="number" min="0.5" max="10" step="0.1" class="sta2e-vfx-number" value="{{values.rayWidth}}" data-sync-number="rayWidth" />
    </div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-rayfeather">Ray Feather</label>
      <input id="sta2e-vfx-rayfeather" type="range" min="0" max="1" step="0.05" name="rayFeather" value="{{values.rayFeather}}" data-sync-range="rayFeather" />
      <input type="number" min="0" max="1" step="0.05" class="sta2e-vfx-number" value="{{values.rayFeather}}" data-sync-number="rayFeather" />
    </div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-rayspeed">Ray Speed</label>
      <input id="sta2e-vfx-rayspeed" type="range" min="0.05" max="4" step="0.05" name="raySpeed" value="{{values.raySpeed}}" data-sync-range="raySpeed" />
      <input type="number" min="0.05" max="4" step="0.05" class="sta2e-vfx-number" value="{{values.raySpeed}}" data-sync-number="raySpeed" />
    </div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-rayopacity">Ray Opacity</label>
      <input id="sta2e-vfx-rayopacity" type="range" min="0" max="1" step="0.05" name="rayOpacity" value="{{values.rayOpacity}}" data-sync-range="rayOpacity" />
      <input type="number" min="0" max="1" step="0.05" class="sta2e-vfx-number" value="{{values.rayOpacity}}" data-sync-number="rayOpacity" />
    </div>

    <div class="sta2e-vfx-row">
      <label for="sta2e-vfx-rayshade">Ray Darkness</label>
      <input id="sta2e-vfx-rayshade" type="range" min="0.1" max="1" step="0.05" name="rayShade" value="{{values.rayShade}}" data-sync-range="rayShade" />
      <input type="number" min="0.1" max="1" step="0.05" class="sta2e-vfx-number" value="{{values.rayShade}}" data-sync-number="rayShade" />
    </div>

  </div>

  <div class="sta2e-vfx-actions">
    <button type="button" data-action="saveClient"><i class="fas fa-user-gear"></i> Save Client</button>
    <button type="button" data-action="saveWorld"><i class="fas fa-globe"></i> Save World</button>
    <button type="button" data-action="reset"><i class="fas fa-rotate-left"></i> Reset</button>
    <button type="button" data-action="stop"><i class="fas fa-stop"></i> Stop</button>
    <button type="button" data-action="close"><i class="fas fa-times"></i> Close</button>
    <button type="button" class="sta2e-vfx-play" data-action="play"><i class="fas fa-play"></i> Play</button>
  </div>
</div>
